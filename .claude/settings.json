{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/exercises/**/*.md)",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-course-prose.sh\"",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Reviewing course prose"
          },
          {
            "type": "command",
            "if": "Write(**/exercises/**/*.md)",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-course-prose.sh\"",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Reviewing course prose"
          },
          {
            "type": "command",
            "if": "MultiEdit(**/exercises/**/*.md)",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-course-prose.sh\"",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "Reviewing course prose"
          }
        ]
      }
    ]
  }
}
