__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.db

# Local Claude Code state (plans, memory, personal overrides) — never published.
# Skills, agents and settings.json ARE published: they encode this repo's
# working conventions and the hooks that enforce them.
# settings.local.json stays ignored, so personal overrides remain personal.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
!.claude/hooks/

# macOS
.DS_Store
